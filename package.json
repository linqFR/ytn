{
  "name": "ytrynot",
  "private": true,
  "description": "Monorepo for the ytrynot project",
  "type": "module",
  "workspaces": [
    "packages/*",
    "shared"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "npm run build -w @ytrynot/dna && npm run build -w @ytrynot/qb && npm run build --workspaces --if-present",
    "test": "vitest run",
    "check": "npx.cmd tsc --noEmit",
    "change": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "tag": "changeset git-tag"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
