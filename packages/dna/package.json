{
  "name": "@ytrynot/dna",
  "version": "0.7.4",
  "description": "Schema validation that compiles to standalone JS function. Zod-like API, serializable, portable, using DNA bytecodes",
  "author": "linqFR",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/linqFR/ytn.git",
    "directory": "packages/dna"
  },
  "bugs": {
    "url": "https://github.com/linqFR/ytn/issues"
  },
  "homepage": "https://github.com/linqFR/ytn/tree/main/packages/dna#readme",
  "keywords": [
    "dna",
    "schema",
    "validation",
    "validator",
    "json-schema",
    "bytecode",
    "zod",
    "typescript",
    "compiler",
    "code-generation",
    "performance",
    "ajv-alternative"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "perf": "node --import tsx --expose-gc ./perf/zod-vs-dna-cycles.ts",
    "perf:maranget": "node --import tsx --expose-gc ./perf/bench-ifchain-vs-maranget.ts",
    "perf:patterns": "node --import tsx --expose-gc ./perf/bench-codegen-patterns.ts"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./toJs": {
      "import": "./dist/toJs.js",
      "types": "./dist/toJs.d.ts"
    },
    "./toJs/min": {
      "import": "./dist/toJs.min.js",
      "types": "./dist/toJs.d.ts"
    },
    "./min": {
      "import": "./dist/index.min.js",
      "types": "./dist/index.d.ts"
    },
    "./introspect": {
      "import": "./dist/introspect.js",
      "types": "./dist/introspect.d.ts"
    },
    "./core": {
      "import": "./dist/core.js",
      "types": "./dist/core.d.ts"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@ytrynot/shared": "*",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "jose": "^6.2.9"
  }
}
