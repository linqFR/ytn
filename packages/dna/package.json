{
  "name": "@ytn/dna",
  "version": "0.3.0",
  "description": "Schema validation that compiles to standalone JS function. Zod-like API, serializable, portable, using DNA bytecodes",
  "author": "linqFR",
  "license": "MIT",
  "keywords": [
    "dna",
    "schema",
    "validation",
    "validator",
    "json-schema",
    "bytecode",
    "zod",
    "typescript",
    "compiler",
    "code-generation",
    "performance",
    "ajv-alternative"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./toJs": {
      "import": "./dist/toJs.js",
      "types": "./dist/toJs.d.ts"
    },
    "./toJs/min": {
      "import": "./dist/toJs.min.js",
      "types": "./dist/toJs.d.ts"
    },
    "./min": {
      "import": "./dist/index.min.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@ytn/shared": "*",
    "tsup": "^8.5.1",
    "tsx": "^4.23.10"
  },
  "dependencies": {
    "jose": "^6.2.8"
  }
}
