{
  "name": "@ytrynot/schvalid",
  "version": "0.3.0",
  "description": "JSON Schema 2020-12 validator with compiled standalone JS function using DNA bytecodes. OpenAPI 3.1 discriminator support. Close to AJV's speed.",
  "author": "linqFR",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dna",
    "json-schema",
    "json-schema-2020-12",
    "validation",
    "validator",
    "schema",
    "ajv",
    "ajv-alternative",
    "openapi",
    "discriminator",
    "dna",
    "typescript",
    "performance"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run tests/schemas",
    "test:full": "vitest run",
    "bench": "npm.cmd run perf",
    "perf": "tsx ./perf/full-comparative-benchmark.ts && tsx ./perf/bundle-performance.ts"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@ytrynot/dna": "*"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@ytrynot/shared": "*",
    "ajv": "^8.20.0",
    "tsup": "^8.5.1",
    "zod": "^4.4.3"
  }
}
