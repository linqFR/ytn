{
  "name": "@ytrynot/cli",
  "version": "0.1.0",
  "description": "DNA-validated CLI router with Maranget decision trees and automatic help generation",
  "author": "linqFR",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/linqFR/ytn.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/linqFR/ytn/issues"
  },
  "homepage": "https://github.com/linqFR/ytn/tree/main/packages/cli#readme",
  "keywords": [
    "cli",
    "router",
    "dna",
    "validation",
    "maranget",
    "decision-tree",
    "typescript",
    "parseargs",
    "dna"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=26.0.0"
  },
