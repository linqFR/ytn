{
  "name": "@ytrynot/cdna",
  "version": "0.2.0",
  "description": "Command-line tool to compile JSON Schema into standalone JS CLI validator and parser using DNA bytecodes.",
  "author": "linqFR",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "cli",
    "dna",
    "schema",
    "validation",
    "validator",
    "json-schema",
    "code-generation",
    "compiler",
    "typescript",
    "developer-tools"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./min": {
      "import": "./dist/index.min.js"
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@ytrynot/dna": "*",
    "tsup": "^8.5.1",
    "tsx": "^4.23.10"
  }
}
