{
  "name": "@ytrynot/cdna",
  "version": "0.2.1",
  "private": true,
  "description": "Command-line tool to compile JSON Schema into standalone JS CLI validator and parser using DNA bytecodes.",
  "author": "linqFR",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/linqFR/ytn.git",
    "directory": "packages/cli-to-dna"
  },
  "bugs": {
    "url": "https://github.com/linqFR/ytn/issues"
  },
  "homepage": "https://github.com/linqFR/ytn/tree/main/packages/cli-to-dna#readme",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=25.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "cli",
    "dna",
    "schema",
    "validation",
    "validator",
    "json-schema",
    "code-generation",
    "compiler",
    "typescript",
    "developer-tools"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./min": {
      "import": "./dist/index.min.js"
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@ytrynot/dna": "*",
    "tsup": "^8.5.1",
    "tsx": "^4.23.11"
  }
}
