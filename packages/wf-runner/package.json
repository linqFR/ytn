{
  "name": "@ytrynot/wf",
  "version": "0.1.0",
  "private": true,
  "description": "Workflow Router for the ytrynot project",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "bin": {
    "wf-compile": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/core.js",
      "types": "./dist/core.d.ts"
    },
    "./editor": {
      "import": "./dist/editor.js",
      "types": "./dist/editor.d.ts"
    },
    "./min": {
      "import": "./dist/index.min.js",
      "types": "./dist/index.d.ts"
    }
  },
  "peerDependencies": {
    "zod": "~4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@ytrynot/shared": "*",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "zod": "~4.4.3"
  }
}
