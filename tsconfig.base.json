{
  "compilerOptions": {
    "target": "esnext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,

    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rootDir": ".",
    "types": [ "node" ]
  },
  "include": [
    "packages/**/src/**/*.ts",
    "packages/**/sandbox/**/*.ts",
    "packages/**/tests/**/*.ts",
    "shared/**/src/**/*.ts",
    "shared/**/sandbox/**/*.ts",
    "shared/**/tests/**/*.ts"
  ],
  "exclude": [
    "**/_archive",
    "**/_archives",
    "**/_docs",
    "**/*_deprecated.ts",
    "**/*_old.ts",
    "**/archive",
    "**/archives",
    "**/dev_tools",
    "**/dist",
    "**/docs",
    "**/node_modules",
    "**/tests/json-schema-suite/bin/*"
  ]
}